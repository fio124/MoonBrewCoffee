@model MoonBrewCoffee.Application.DTOs.ProcesoPreparacionDTO

@{
    ViewData["Title"] = "Editar Proceso";
}

<div class="maintenance-header">

    <div>

        <h1 class="fw-bold mb-1">
            Editar Proceso de Preparación
        </h1>

        <p class="text-muted mb-0">
            Actualiza la información del proceso seleccionado.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>

<div class="card shadow border-0 maintenance-form-panel">

    <div class="card-body p-5">

        <form asp-action="Edit">

            <input asp-for="IdProceso" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <partial name="_ProcesoPreparacionForm"
                     model="Model" />

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-3">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>

                <button type="submit"
                        class="btn btn-warning px-5">

                    <i class="bi bi-pencil-square"></i>

                    Actualizar Proceso

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
