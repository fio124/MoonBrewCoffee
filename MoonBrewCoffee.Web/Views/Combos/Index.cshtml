@model IEnumerable<MoonBrewCoffee.Application.DTOs.ComboDTO>

@{
    ViewData["Title"] = "Combos";
}

<div class="maintenance-header">

    <div>

        <h1 class="fw-bold mb-1">
            Combos
        </h1>

        <p class="text-muted mb-0">
            Administra los combos disponibles de MoonBrew Coffee.
        </p>

    </div>

    <a asp-action="Create" class="btn btn-success">

        <i class="bi bi-plus-circle-fill"></i>

        Nuevo Combo

    </a>

</div>

<div class="card shadow-sm border-0 maintenance-table-panel">

    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th style="width:90px;">
                            Imagen
                        </th>

                        <th>
                            Nombre
                        </th>

                        <th>
                            Descripción
                        </th>

                        <th>
                            Precio
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(item.ImagenURL))
                                {
                                    <img src="@Url.Action("Image", "Combos", new { id = item.IdCombo })"
                                         alt="@item.Nombre"
                                         loading="lazy"
                                         decoding="async"
                                         class="rounded"
                                         style="width:70px;height:70px;object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="menu-card-placeholder rounded"
                                         style="width:70px;height:70px;">
                                        <i class="bi bi-gift-fill"></i>
                                    </div>
                                }

                            </td>

                            <td>

                                <strong>

                                    @item.Nombre

                                </strong>

                            </td>

                            <td>

                                @item.Descripcion

                            </td>

                            <td>

                                <strong class="text-success">

                                    ₡@item.PrecioCombo.ToColones()

                                </strong>

                            </td>

                            <td>

                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">

                                        Activo

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactivo

                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.IdCombo"
                                   class="btn btn-sm btn-info me-1">

                                    <i class="bi bi-eye-fill"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.IdCombo"
                                   class="btn btn-sm btn-warning me-1">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>

                                <button class="btn btn-sm btn-danger btn-desactivar"
                                        data-id="@item.IdCombo"
                                        data-nombre="@item.Nombre">

                                    <i class="bi bi-slash-circle-fill"></i>

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- Modal -->

<div class="modal fade"
     id="modalDesactivar"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 rounded-4">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    Desactivar Combo

                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body text-center">

                <i class="bi bi-exclamation-triangle-fill text-danger"
                   style="font-size:65px;">
                </i>

                <h4 class="mt-3">

                    ¿Deseas desactivar este combo?

                </h4>

                <p id="nombreCombo"
                   class="text-muted">
                </p>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <form id="formDesactivar"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button class="btn btn-danger">

                        Sí, Desactivar

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        const modal = new bootstrap.Modal(
        document.getElementById("modalDesactivar"));

        document.querySelectorAll(".btn-desactivar")
        .forEach(btn=>{

        btn.addEventListener("click",()=>{

        document.getElementById("nombreCombo")
        .innerHTML="<strong>"+btn.dataset.nombre+"</strong>";

        document.getElementById("formDesactivar")
        .action="/Combos/Delete/"+btn.dataset.id;

        modal.show();

        });

        });

    </script>

}
