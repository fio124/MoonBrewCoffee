@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<aside class="sidebar">

    <div class="sidebar-logo">

        <a asp-controller="Home" asp-action="Index">

            <img src="~/Imagenes/LOGO.png" alt="MoonBrew Logo" />

        </a>

        <h2>MoonBrew</h2>

    </div>

    <div class="sidebar-subtitle">

        Coffee Management

    </div>

    <nav class="sidebar-menu">

        <a asp-controller="Home"
           asp-action="Index"
           class="@(controller == "Home" ? "active" : "")">

            <i class="bi bi-house-door-fill"></i>

            <span>Inicio</span>

        </a>

        <a asp-controller="Catalogo"
           asp-action="Index"
           class="@(controller == "Catalogo" ? "active" : "")">

            <i class="bi bi-cup-hot-fill"></i>

            <span>Catálogo</span>

        </a>

        <a asp-controller="Combos"
           asp-action="Index"
           class="@(controller == "Combos" ? "active" : "")">

            <i class="bi bi-gift-fill"></i>

            <span>Combos</span>

        </a>

        <a asp-controller="Menus"
           asp-action="Index"
           class="@(controller == "Menus" ? "active" : "")">

            <i class="bi bi-journal-richtext"></i>

            <span>Menús</span>

        </a>

        <a asp-controller="Categorias"
           asp-action="Index"
           class="@(controller == "Categorias" ? "active" : "")">

            <i class="bi bi-grid-fill"></i>

            <span>Categorías</span>

        </a>

        <a asp-controller="Ingredientes"
           asp-action="Index"
           class="@(controller == "Ingredientes" ? "active" : "")">

            <i class="bi bi-box-seam-fill"></i>

            <span>Ingredientes</span>

        </a>

        <a asp-controller="Usuarios"
           asp-action="Index"
           class="@(controller == "Usuarios" ? "active" : "")">

            <i class="bi bi-people-fill"></i>

            <span>Usuarios</span>

        </a>

    </nav>

    <div class="sidebar-footer">

        <div class="coffee-card">

            <i class="bi bi-cup-hot"></i>

            <div>

                <strong>MoonBrew Coffee</strong>

                <small>Fresh Coffee Everyday</small>

            </div>

        </div>

    </div>

</aside>