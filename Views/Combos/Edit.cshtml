@model IEnumerable<MoonBrewCoffee.Models.Entidades.Combo>

@{
    ViewData["Title"] = "Nuestros Combos";
}

<section class="hero-small text-center mb-5">

    <span class="badge bg-warning text-dark mb-3">
        MoonBrew Coffee
    </span>

    <h1 class="display-5 fw-bold">
        Nuestros Combos
    </h1>

    <p class="lead text-muted">
        Disfruta nuestras mejores combinaciones de café y postres.
    </p>

</section>

<div class="row g-4">

    @foreach (var item in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6">

            <div class="coffee-card-product h-100">

                <div class="product-image">

                    <img src="@item.ImagenURL"
                         alt="@item.Nombre" />

                </div>

                <div class="product-info">

                    <span class="category-badge">

                        Combo

                    </span>

                    <h3>

                        @item.Nombre

                    </h3>

                    <p>

                        @item.Descripcion

                    </p>

                    <div class="product-footer">

                        <div>

                            <small>Precio</small>

                            <h4>

                                ₡@item.PrecioCombo

                            </h4>

                        </div>

                        <a asp-action="Details"
                           asp-route-id="@item.IdCombo"
                           class="btn btn-primary">

                            Ver Combo

                        </a>

                    </div>

                </div>

            </div>

        </div>
    }

</div>