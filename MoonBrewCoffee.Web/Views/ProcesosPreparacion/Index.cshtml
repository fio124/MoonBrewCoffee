@model IEnumerable<MoonBrewCoffee.Application.DTOs.ProcesoPreparacionResumenDTO>
@{
    ViewData["Title"] = "Procesos de Preparación";
}

<div class="maintenance-header">

    <div>

        <h1 class="fw-bold">
            Procesos de Preparación
        </h1>

        <p class="text-muted">
            Administración de los pasos de preparación de los productos.
        </p>

    </div>

    <a asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-plus-circle-fill"></i>

        Agregar Paso

    </a>

</div>

<div class="card shadow border-0 maintenance-table-panel">

    <div class="card-body p-0">

        <table class="table table-hover align-middle maintenance-table">

            <thead class="table-dark">

                <tr>

                    <th>Producto</th>

                    <th class="text-center">

                        Pasos

                    </th>

                    <th class="text-center">

                        Tiempo Total

                    </th>

                    <th width="150"></th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {

                    <tr>

                        <td>

                            <strong>

                                @item.NombreProducto

                            </strong>

                        </td>

                        <td class="text-center">

                            @item.CantidadPasos

                        </td>

                        <td class="text-center">

                            @item.TiempoTotal min

                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.IdProducto"
                               class="btn btn-info btn-sm">

                                <i class="bi bi-eye-fill"></i>

                            </a>

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>
