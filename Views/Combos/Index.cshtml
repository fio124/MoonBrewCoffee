@foreach (var item in Model)
{
    <div class="col-xl-3 col-lg-4 col-md-6">

        <partial name="_ProductCard"
                 model='new
                 {
                     Imagen = item.ImagenURL,
                     Nombre = item.Nombre,
                     Descripcion = item.Descripcion,
                     Precio = item.PrecioCombo,
                     Tipo = "Combo",
                     Url = Url.Action("Details", "Combos",
                                             new { id = item.IdCombo })
                 }' />

</div>
}