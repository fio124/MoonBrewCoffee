@model dynamic

<div class="coffee-card-product h-100">

    <div class="product-image">

        <img src="@Model.Imagen"
             alt="@Model.Nombre" />

    </div>

    <div class="product-info">

        @if (!string.IsNullOrEmpty(Model.Tipo))
        {
            <span class="category-badge">
                @Model.Tipo
            </span>
        }

        <h3>@Model.Nombre</h3>

        <p>@Model.Descripcion</p>

        <div class="product-footer">

            <div>

                <small>Precio</small>

                <h4>₡@Model.Precio.ToColones()</h4>

            </div>

            <a href="@Model.Url"
               class="btn btn-primary">

                Ver detalle

            </a>

        </div>

    </div>

</div>
