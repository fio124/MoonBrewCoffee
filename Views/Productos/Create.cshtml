@model MoonBrewCoffee.Models.Entidades.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Nuevo Producto
        </h1>

        <p class="text-muted">
            Agrega un nuevo producto al catálogo de MoonBrew Coffee.
        </p>

    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>

<div class="card shadow border-0">

    <div class="card-body p-5">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <partial name="_ProductoForm" model="Model" />

            <hr class="my-4" />

            <div class="text-end">

                <button class="btn btn-success px-5">

                    <i class="bi bi-check-circle-fill"></i>

                    Guardar Producto

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.getElementById("txtImagen")
        .addEventListener("input",function(){

        document.getElementById("preview").src=this.value;

        });

    </script>

}