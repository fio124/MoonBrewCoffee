@model MoonBrewCoffee.Models.Entidades.Producto

@{
    ViewData["Title"] = "Detalle Producto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold mb-1">Detalle del Producto</h1>
        <p class="text-muted mb-0">Información completa del producto seleccionado.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Volver
    </a>
</div>

<div class="card shadow border-0">
    <div class="card-body p-5">

        <div class="row g-5 align-items-center">

            <div class="col-lg-5 text-center">
                <img src="@Model.Image64"
                     alt="@Model.Nombre"
                     class="img-fluid rounded shadow"
                     style="max-height:380px; object-fit:cover;" />
            </div>

            <div class="col-lg-7">

                <span class="badge @(Model.Activo ? "bg-success" : "bg-danger") mb-3">
                    @(Model.Activo ? "Disponible" : "Inactivo")
                </span>

                <h2 class="fw-bold">@Model.Nombre</h2>

                <p class="text-muted fs-5">
                    @Model.Descripcion
                </p>

                <hr />

                <div class="row g-4">

                    <div class="col-md-6">
                        <div class="stat-card">
                            <h4>₡@Model.Precio</h4>
                            <p>Precio</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="stat-card">
                            <h4>@Model.TiempoPreparacion min</h4>
                            <p>Preparación</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="stat-card">
                            <h4>@(Model.Categoria?.Nombre ?? "Sin categoría")</h4>
                            <p>Categoría</p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="stat-card">
                            <h4>#@Model.IdProducto</h4>
                            <p>Código</p>
                        </div>
                    </div>

                </div>

                <div class="mt-5 d-flex gap-3">

                    <a asp-action="Edit"
                       asp-route-id="@Model.IdProducto"
                       class="btn btn-warning px-4">
                        <i class="bi bi-pencil-square"></i>
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@Model.IdProducto"
                       class="btn btn-danger px-4">
                        <i class="bi bi-x-circle-fill"></i>
                        Desactivar
                    </a>

                </div>

            </div>

        </div>

    </div>
</div>