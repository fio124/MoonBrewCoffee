@model MoonBrewCoffee.Application.DTOs.UsuarioDTO

<div class="row">

    <div class="col-lg-7">

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="Nombre" class="form-label fw-semibold"></label>

                    <input asp-for="Nombre" class="form-control" />

                    <span asp-validation-for="Nombre" class="text-danger"></span>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="Apellido" class="form-label fw-semibold"></label>

                    <input asp-for="Apellido" class="form-control" />

                    <span asp-validation-for="Apellido" class="text-danger"></span>

                </div>

            </div>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="Correo" class="form-label fw-semibold"></label>

                    <input asp-for="Correo"
                           type="email"
                           class="form-control" />

                    <span asp-validation-for="Correo" class="text-danger"></span>

                </div>

            </div>

            <div class="col-md-6">

                <div class="mb-4">

                    <label asp-for="Telefono" class="form-label fw-semibold"></label>

                    <input asp-for="Telefono" class="form-control" />

                    <span asp-validation-for="Telefono" class="text-danger"></span>

                </div>

            </div>

        </div>

        <div class="mb-4">

            <label asp-for="PasswordHash" class="form-label fw-semibold">

                Contraseña

            </label>

            <input asp-for="PasswordHash"
                   type="password"
                   class="form-control" />

            <span asp-validation-for="PasswordHash"
                  class="text-danger"></span>

        </div>

    </div>

    <div class="col-lg-5">

        <div class="mb-4">

            <label asp-for="IdRol"
                   class="form-label fw-semibold">
                Rol
            </label>

            <select asp-for="IdRol"
                    class="form-select"
                    asp-items="ViewBag.IdRol">

                <option value="">
                    Seleccione un rol
                </option>

            </select>

            <span asp-validation-for="IdRol"
                  class="text-danger"></span>

        </div>

        <div class="mb-4">

            <label asp-for="FechaRegistro"
                   class="form-label fw-semibold">

            </label>

            <input asp-for="FechaRegistro"
                   type="date"
                   class="form-control" />

            <span asp-validation-for="FechaRegistro"
                  class="text-danger"></span>

        </div>

        <div class="mb-4">

            <label class="form-label fw-semibold">

                Estado

            </label>

            <select asp-for="Activo"
                    class="form-select">

                <option value="true">

                    🟢 Activo

                </option>

                <option value="false">

                    🔴 Inactivo

                </option>

            </select>

        </div>

        <div class="alert alert-light border shadow-sm mt-4">

            <h6 class="fw-bold mb-3">

                Información

            </h6>

            <p class="mb-2">

                • El correo debe ser único.

            </p>

            <p class="mb-2">

                • La contraseña será utilizada para iniciar sesión.

            </p>

            <p class="mb-0">

                • Los usuarios inactivos no podrán acceder al sistema.

            </p>

        </div>

    </div>

</div>