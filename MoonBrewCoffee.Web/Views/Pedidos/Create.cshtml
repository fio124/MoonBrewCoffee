@model MoonBrewCoffee.Web.Models.CheckoutViewModel
@using MoonBrewCoffee.Web.Formatting
@using System.Globalization

@{
    ViewData["Title"] = "Registrar pedido";
    Layout = Model.CanSelectClient ? "_Layout" : "_ClienteLayout";
}

<section class="client-page-header">
    <div><span>Finalizar compra</span><h1 data-i18n-key="orders.checkout">Registrar pedido</h1><p data-i18n-key="orders.checkoutCopy">Completa la entrega y el pago en este formulario tipo factura.</p></div>
    <span class="client-page-icon"><i class="bi bi-receipt"></i></span>
</section>

<form asp-action="Create" method="post" class="checkout" data-checkout data-cart-total="@Model.Cart.Total.ToString(System.Globalization.CultureInfo.InvariantCulture)">
    <div asp-validation-summary="ModelOnly" class="login-validation"></div>
    <section class="checkout-main">
        <div class="checkout-section">
            <header><span>01</span><div><h2 data-i18n-key="orders.generalData">Datos generales</h2><p>Información del cliente y responsable del pedido.</p></div></header>
            <div class="checkout-fields">
                <label><span>Fecha del pedido</span><input value="@DateTime.Now.ToString("g", CultureInfo.CurrentCulture)" readonly /></label>
                @if (Model.CanSelectClient)
                {
                    <label><span asp-for="ClientId"></span><select asp-for="ClientId" asp-items="Model.Clients"><option value="">Selecciona un cliente</option></select><span asp-validation-for="ClientId"></span></label>
                    <label><span>Encargado</span><input value="@Model.CurrentUser.NombreCompleto" readonly /></label>
                }
                else
                {
                    <label><span>Cliente</span><input value="@Model.CurrentUser.NombreCompleto" readonly /></label>
                    <label><span>Correo y teléfono</span><input value="@Model.CurrentUser.Correo · @Model.CurrentUser.Telefono" readonly /></label>
                }
                <label class="checkout-wide"><span>Método de entrega</span><select asp-for="DeliveryType" data-delivery-type><option value="tienda">Recogida en tienda</option><option value="domicilio">Entrega a domicilio (+ ₡2.500)</option></select></label>
                <label class="checkout-wide" data-address-field><span asp-for="DeliveryAddress"></span><textarea asp-for="DeliveryAddress" rows="3" placeholder="Provincia, cantón, distrito y señas exactas"></textarea><span asp-validation-for="DeliveryAddress"></span></label>
            </div>
        </div>

        <div class="checkout-section">
            <header><span>02</span><div><h2 data-i18n-key="orders.purchaseDetail">Detalle de compra</h2><p>Productos y combos incluidos en el pedido.</p></div></header>
            <div class="checkout-lines">
                @foreach (var line in Model.Cart.Lines)
                {
                    <article><div><span>@(line.ItemType == "combo" ? "Combo" : "Producto")</span><strong>@line.Name</strong><small>@(line.Notes ?? "Sin observaciones")</small></div><b>@line.Quantity × ₡@line.UnitPrice.ToColones()</b><strong>₡@line.Subtotal.ToColones()</strong></article>
                }
            </div>
        </div>

        <div class="checkout-section">
            <header><span>03</span><div><h2 data-i18n-key="orders.paymentProcess">Proceso de pago</h2><p>Simulación segura; los datos de tarjeta no se almacenan.</p></div></header>
            <div class="payment-methods">
                <label><input asp-for="PaymentMethod" type="radio" value="credito" /><span><i class="bi bi-credit-card"></i> <b data-i18n-key="orders.credit">Crédito</b></span></label>
                <label><input asp-for="PaymentMethod" type="radio" value="debito" /><span><i class="bi bi-credit-card-2-front"></i> <b data-i18n-key="orders.debit">Débito</b></span></label>
                <label><input asp-for="PaymentMethod" type="radio" value="efectivo" /><span><i class="bi bi-cash-coin"></i> <b data-i18n-key="orders.cash">Efectivo</b></span></label>
            </div>
            <div class="checkout-fields" data-card-fields>
                <label class="checkout-wide"><span asp-for="CardholderName"></span><input asp-for="CardholderName" autocomplete="cc-name" /><span asp-validation-for="CardholderName"></span></label>
                <label class="checkout-wide"><span asp-for="CardNumber"></span><input asp-for="CardNumber" inputmode="numeric" autocomplete="cc-number" maxlength="23" placeholder="0000 0000 0000 0000" /><span asp-validation-for="CardNumber"></span></label>
                <label><span asp-for="CardExpiry"></span><input asp-for="CardExpiry" autocomplete="cc-exp" maxlength="5" placeholder="MM/AA" /><span asp-validation-for="CardExpiry"></span></label>
                <label><span asp-for="CardCvv"></span><input asp-for="CardCvv" type="password" inputmode="numeric" autocomplete="cc-csc" maxlength="4" /><span asp-validation-for="CardCvv"></span></label>
            </div>
            <div class="checkout-fields" data-cash-fields>
                <label class="checkout-wide"><span asp-for="CashReceived"></span><input asp-for="CashReceived" type="number" min="0" step="100" data-cash-received /><span asp-validation-for="CashReceived"></span></label>
                <div class="checkout-change"><span data-i18n-key="orders.change">Vuelto estimado</span><strong data-cash-change>₡0</strong></div>
            </div>
        </div>
    </section>

    <aside class="cart-summary checkout-summary">
        <span class="cart-summary-eyebrow">Resumen final</span><h2>Totales</h2>
        <dl><div><dt>Artículos</dt><dd>@Model.Cart.ItemCount</dd></div><div><dt>Total sin impuestos</dt><dd>₡@Model.Cart.Subtotal.ToColones()</dd></div><div><dt>Impuesto</dt><dd>₡@Model.Cart.Tax.ToColones()</dd></div><div><dt>Envío</dt><dd data-checkout-shipping>₡@Model.ShippingCost.ToColones()</dd></div><div class="cart-summary-total"><dt>Total</dt><dd data-checkout-total>₡@Model.GrandTotal.ToColones()</dd></div></dl>
        <button type="submit" class="client-primary-button checkout-submit"><i class="bi bi-shield-check"></i> <span data-i18n-key="orders.submit">Registrar y pagar pedido</span></button>
        <a asp-controller="Cliente" asp-action="Carrito" class="cart-continue-link"><i class="bi bi-arrow-left"></i> Volver al carrito</a>
    </aside>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}
