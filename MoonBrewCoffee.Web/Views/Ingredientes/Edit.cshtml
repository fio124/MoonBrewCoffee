@model MoonBrewCoffee.Application.DTOs.IngredienteDTO

@{
    ViewData["Title"] = "Editar Ingrediente";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Editar Ingrediente
        </h1>

        <p class="text-muted">
            Modifica la información del ingrediente.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>

<div class="card shadow border-0">

    <div class="card-body p-5">

        <form asp-action="Edit">

            <input asp-for="IdIngrediente"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <partial name="_IngredienteForm" model="Model" />

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-3">

                <a asp-action="Index"
                   class="btn btn-light">

                    Cancelar

                </a>

                <button class="btn btn-warning px-5">

                    <i class="bi bi-pencil-square"></i>

                    Actualizar

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}