@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO -->

<section class="hero fade-up">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <span class="badge bg-warning text-dark px-3 py-2 mb-4">
                ☕ El mejor Café
            </span>

            <h1>
                El café perfecto para comenzar tu día.
            </h1>

            <p class="mt-4">

                En MoonBrew Coffee encontrarás bebidas artesanales,
                postres, combos y menús preparados con ingredientes
                de la mejor calidad.

            </p>

            <div class="mt-5">

                <a asp-controller="Catalogo"
                   asp-action="Index"
                   class="btn btn-light me-3">

                    Ver Catálogo

                </a>

                <a asp-controller="Combos"
                   asp-action="Index"
                   class="btn btn-outline-light">

                    Combos

                </a>

            </div>

        </div>

        <div class="col-lg-6 text-center">

            <img src="~/Imagenes/banner.png"
                 class="img-fluid rounded-4 shadow-lg"
                 style="max-height:500px;" />

        </div>

    </div>

</section>

<br />
<br />

<h2 class="section-title">

    Categorías principales

</h2>

<div class="row g-4">

    <!-- BEBIDAS -->

    <div class="col-lg-4">

        <div class="category-card">

            <div class="category-image">

                <img src="~/Imagenes/CatBebidas.png" />

            </div>

            <div class="category-content">

                <div class="category-icon">

                    ☕

                </div>

                <h3>Bebidas</h3>

                <p>

                    Cafés calientes, fríos, frappés y bebidas especiales
                    preparadas por nuestros baristas.

                </p>

                <a asp-controller="Catalogo"
                   asp-action="Index"
                   class="category-btn">

                    Explorar bebidas →

                </a>

            </div>

        </div>

    </div>

    <!-- POSTRES -->

    <div class="col-lg-4">

        <div class="category-card">

            <div class="category-image">

                <img src="~/Imagenes/CatPostres.png" />

            </div>

            <div class="category-content">

                <div class="category-icon">

                    🍰

                </div>

                <h3>Postres</h3>

                <p>

                    Cheesecakes, brownies, galletas y postres
                    artesanales recién preparados.

                </p>

                <a asp-controller="Catalogo"
                   asp-action="Index"
                   class="category-btn">

                    Explorar postres →

                </a>

            </div>

        </div>

    </div>

    <!-- COMBOS -->

    <div class="col-lg-4">

        <div class="category-card">

            <div class="category-image">

                <img src="~/Imagenes/ComboDulce.png" />

            </div>

            <div class="category-content">

                <div class="category-icon">

                    🎁

                </div>

                <h3>Combos</h3>

                <p>

                    Combina tus bebidas favoritas con deliciosos
                    postres y ahorra con nuestras promociones.

                </p>

                <a asp-controller="Catalogo"
                   asp-action="Index"
                   class="category-btn">

                    Explorar combos →

                </a>

            </div>

        </div>

    </div>

</div>

<br />
<br />
<br />

<h2 class="section-title">

    MoonBrew en números

</h2>

<div class="row g-4">

    <div class="col-lg-3">

        <div class="stat-card">

            <i class="bi bi-cup-hot-fill"></i>

            <h2>20+</h2>

            <p>Productos</p>

        </div>

    </div>

    <div class="col-lg-3">

        <div class="stat-card">

            <i class="bi bi-gift-fill"></i>

            <h2>8</h2>

            <p>Combos</p>

        </div>

    </div>

    <div class="col-lg-3">

        <div class="stat-card">

            <i class="bi bi-journal-richtext"></i>

            <h2>3</h2>

            <p>Menús</p>

        </div>

    </div>

    <div class="col-lg-3">

        <div class="stat-card">

            <i class="bi bi-award-fill"></i>

            <h2>100%</h2>

            <p>Calidad</p>

        </div>

    </div>

</div>