@model MoonBrewCoffee.Models.Entidades.Combo

@{
    ViewData["Title"] = Model.Nombre;
}

<div class="container-fluid">

    <a asp-action="Index"
       class="btn btn-outline-secondary mb-4">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

    <div class="card border-0 shadow-lg overflow-hidden">

        <div class="row g-0">

            <div class="col-lg-6">

                <img src="@Model.ImagenURL"
                     class="w-100 h-100"
                     style="object-fit:cover;min-height:550px;" />

            </div>

            <div class="col-lg-6">

                <div class="p-5">

                    <span class="badge bg-warning text-dark mb-3">

                        Combo Especial

                    </span>

                    <h1 class="fw-bold">

                        @Model.Nombre

                    </h1>

                    <h2 class="text-primary mt-3">

                        ₡@Model.PrecioCombo

                    </h2>

                    <hr />

                    <h5>

                        Descripción

                    </h5>

                    <p class="text-muted">

                        @Model.Descripcion

                    </p>

                    <hr />

                    <h5>

                        Incluye

                    </h5>

                    <ul class="list-group list-group-flush">

                        <li class="list-group-item">

                            ☕ Café Premium

                        </li>

                        <li class="list-group-item">

                            🥐 Acompañamiento

                        </li>

                        <li class="list-group-item">

                            🍪 Postre

                        </li>

                    </ul>

                    <div class="mt-5">

                        <a asp-action="Index"
                           class="btn btn-dark btn-lg">

                            Ver más Combos

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>