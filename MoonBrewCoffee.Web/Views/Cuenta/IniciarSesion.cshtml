@model MoonBrewCoffee.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_ClienteLayout";
}

<section class="login-shell">
    <div class="login-visual" aria-hidden="true">
        <div class="login-visual-content">
            <span><i class="bi bi-stars"></i> MoonBrew Coffee</span>
            <h1>Tu próxima taza<br />te está esperando.</h1>
            <p>Inicia sesión para consultar tu perfil, tus pedidos y el estado de cada preparación.</p>
        </div>
    </div>

    <div class="login-panel">
        <div class="login-heading">
            <span class="login-icon"><i class="bi bi-person"></i></span>
            <div>
                <span>Bienvenido de nuevo</span>
                <h2>Iniciar sesión</h2>
                <p>Ingresa con los datos de tu cuenta MoonBrew.</p>
            </div>
        </div>

        <form asp-action="IniciarSesion" method="post" class="login-form">
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>

            <div class="login-field">
                <label asp-for="Email"></label>
                <div class="login-input">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" autocomplete="email" placeholder="nombre@correo.com" data-i18n-placeholder-key="clientPortal.emailPlaceholder" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="login-field">
                <label asp-for="Password"></label>
                <div class="login-input">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" autocomplete="current-password" placeholder="Ingresa tu contraseña" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="login-submit">
                <i class="bi bi-box-arrow-in-right"></i>
                Iniciar sesión
            </button>
        </form>

        <a asp-action="Registrarse" class="login-register-link">
            <i class="bi bi-person-plus"></i>
            <span data-i18n-key="account.noAccount">¿No tienes cuenta?</span>
            <strong data-i18n-key="account.register">Regístrate</strong>
        </a>

        <a asp-controller="Cliente" asp-action="Index" class="login-back">
            <i class="bi bi-arrow-left"></i> Continuar como invitado
        </a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
