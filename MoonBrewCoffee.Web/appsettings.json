{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MoonBrewCoffee;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ScheduledTasks": {
    "Enabled": true,
    "PriceChangesEnabled": false,
    "TardeandoMenuName": "Tardeando",
    "TardeandoIntervalSeconds": 900,
    "GeneralComboIntervalSeconds": 1200,
    "TardeandoDiscountPercent": 5,
    "MinimumComboPrice": 1500,
    "GeneralComboIncrease": 10,
    "MaxPriceExecutionsPerRun": 4,
    "RunImmediately": true
  },

  "AllowedHosts": "*"
}
