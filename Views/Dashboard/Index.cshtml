@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="fw-bold mb-1">
    Bienvenido ☕
</h1>

<p class="text-muted mb-5">
    Panel de administración de MoonBrew Coffee
</p>

<div class="row g-4">

    <div class="col-lg-3">

        <div class="stat-card">

            <h2>25</h2>

            <p>Productos</p>

        </div>

    </div>

    <div class="col-lg-3">

        <div class="stat-card">

            <h2>6</h2>

            <p>Categorías</p>

        </div>

    </div>

    <div class="col-lg-3">

        <div class="stat-card">

            <h2>34</h2>

            <p>Ingredientes</p>

        </div>

    </div>

    <div class="col-lg-3">

        <div class="stat-card">

            <h2>12</h2>

            <p>Usuarios</p>

        </div>

    </div>

</div>

<br />

<div class="card shadow border-0">

    <div class="card-body">

        <h3>

            Accesos rápidos

        </h3>

        <hr />

        <div class="d-flex flex-wrap gap-3">

            <a asp-controller="Productos"
               asp-action="Index"
               class="btn btn-dark">

                Productos

            </a>

            <a asp-controller="Categorias"
               asp-action="Index"
               class="btn btn-dark">

                Categorías

            </a>

            <a asp-controller="Combos"
               asp-action="Index"
               class="btn btn-dark">

                Combos

            </a>

            <a asp-controller="Menus"
               asp-action="Index"
               class="btn btn-dark">

                Menús

            </a>

            <a asp-controller="Usuarios"
               asp-action="Index"
               class="btn btn-dark">

                Usuarios

            </a>

        </div>

    </div>

</div>