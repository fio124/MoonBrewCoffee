@model MoonBrewCoffee.Application.DTOs.IngredienteDTO

@{
    ViewData["Title"] = "Detalle Ingrediente";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Detalle del Ingrediente
        </h1>

        <p class="text-muted">
            Información del ingrediente.
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>

        Volver

    </a>

</div>

<div class="card shadow border-0">

    <div class="card-body p-5">

        <h2 class="fw-bold">

            @Model.Nombre

        </h2>

        <hr />

        <div class="row">

            <div class="col-md-6">

                <h6 class="text-muted">

                    Estado

                </h6>

                @if (Model.Activo)
                {
                    <span class="badge bg-success fs-6">

                        Activo

                    </span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">

                        Inactivo

                    </span>
                }

            </div>

            <div class="col-md-6">

                <h6 class="text-muted">

                    Código

                </h6>

                <h4>#@Model.IdIngrediente</h4>

            </div>

        </div>

        <hr class="my-4" />

        <a asp-action="Edit"
           asp-route-id="@Model.IdIngrediente"
           class="btn btn-warning">

            <i class="bi bi-pencil-square"></i>

            Editar

        </a>

    </div>

</div>