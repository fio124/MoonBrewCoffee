@model MoonBrewCoffee.Infrastructure.Models.Entidades.Producto

@{
    Layout = "_ClienteLayout";
    ViewData["Title"] = Model.Nombre;
}

<div class="container">

    <div class="row g-4">
        <div class="col-lg-6">

            @if (!string.IsNullOrWhiteSpace(Model.Image64))
            {
                <img src="@Url.Action("Image", "Productos", new { id = Model.IdProducto })"
                     alt="@Model.Nombre"
                     loading="lazy"
                     class="img-fluid rounded-4 shadow" />
            }
            else
            {
                <div class="maintenance-image-placeholder">
                    <i class="bi bi-cup-hot"></i><span>Sin imagen</span>
                </div>
            }

        </div>

        <div class="col-lg-6">

            <h1>@Model.Nombre</h1>

            <p class="text-muted">

                @Model.Descripcion

            </p>

            <h2 class="text-success">

                ₡@Model.Precio.ToColones()

            </h2>

            <br />

            <p>

                <strong>Tiempo de preparación:</strong>

                @Model.TiempoPreparacion minutos

            </p>

            <br />

            <button type="button" class="client-primary-button border-0" data-cart-add
                    data-item-type="producto" data-item-id="@Model.IdProducto">
                <i class="bi bi-bag-plus"></i> <span data-i18n-key="orders.addToCart">Agregar</span>
            </button>

            <a asp-action="Index"
               class="btn btn-outline-dark">

                ← Volver al catálogo

            </a>

        </div>

    </div>

</div>
