@model MoonBrewCoffee.Application.DTOs.IngredienteDTO

<div class="row">

    <div class="col-lg-8">

        <div class="mb-4">

            <label asp-for="Nombre"
                   class="form-label fw-semibold">
            </label>

            <input asp-for="Nombre"
                   class="form-control" />

            <span asp-validation-for="Nombre"
                  class="text-danger">
            </span>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="mb-4">

            <label class="form-label fw-semibold">

                Estado

            </label>

            <select asp-for="Activo"
                    class="form-select">

                <option value="true">
                    🟢 Activo
                </option>

                <option value="false">
                    🔴 Inactivo
                </option>

            </select>

        </div>

    </div>

</div>