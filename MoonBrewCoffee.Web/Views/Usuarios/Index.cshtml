@model IEnumerable<MoonBrewCoffee.Application.DTOs.UsuarioDTO>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="maintenance-header">

    <div>

        <h1 class="fw-bold mb-1">
            Usuarios
        </h1>

        <p class="text-muted mb-0">
            Administra los usuarios registrados en MoonBrew Coffee.
        </p>

    </div>

    <a asp-action="Create" class="btn btn-success">

        <i class="bi bi-person-plus-fill"></i>

        Nuevo Usuario

    </a>

</div>

<div class="card shadow-sm border-0 maintenance-table-panel">

    <div class="card-body">


        <div class="table-responsive">

            <table class="table table-hover align-middle"
                   id="tablaUsuarios">

                <thead>

                    <tr>

                        <th>Usuario</th>

                        <th>Rol</th>

                        <th>Correo</th>

                        <th>Teléfono</th>

                        <th>Estado</th>

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-dark text-white
                                                    d-flex justify-content-center
                                                    align-items-center me-3"
                                         style="width:45px;height:45px;font-weight:bold;">

                                        @(string.IsNullOrEmpty(item.Nombre)
                                                                            ? "?"
                                                                            : item.Nombre.Substring(0, 1).ToUpper())

                                </div>

                                    <div>

                                        <strong>

                                            @item.Nombre @item.Apellido

                                        </strong>

                                        <br />

                                        <small class="text-muted">

                                            ID #@item.IdUsuario

                                        </small>

                                    </div>

                                </div>

                            </td>

                            <td>

                                @item.NombreRol

                            </td>

                            <td>

                                @item.Correo

                            </td>

                            <td>

                                @item.Telefono

                            </td>

                            <td>

                            @if (item.Activo)
                                {
                                    <span class="badge bg-success">

                                        Activo

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactivo

                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.IdUsuario"
                                   class="btn btn-sm btn-info me-1">

                                    <i class="bi bi-eye-fill"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.IdUsuario"
                                   class="btn btn-sm btn-warning me-1">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>

                                <button class="btn btn-sm btn-danger btn-desactivar"
                                        data-id="@item.IdUsuario"
                                        data-nombre="@item.Nombre @item.Apellido">

                                    <i class="bi bi-slash-circle-fill"></i>

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- Modal -->

<div class="modal fade"
     id="modalDesactivar"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 rounded-4">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    Desactivar Usuario

                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="text-center">

                    <i class="bi bi-person-x-fill text-danger"
                       style="font-size:65px;">
                    </i>

                    <h4 class="mt-3">

                        ¿Deseas desactivar este usuario?

                    </h4>

                    <p id="nombreUsuario"
                       class="text-muted">
                    </p>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <form id="formDesactivar"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button class="btn btn-danger">

                        Sí, Desactivar

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("buscarUsuario")
        .addEventListener("keyup",function(){

        let filtro=this.value.toLowerCase();

        let filas=document.querySelectorAll("#tablaUsuarios tbody tr");

        filas.forEach(fila=>{

        let texto=fila.innerText.toLowerCase();

        fila.style.display=texto.includes(filtro)?"":"none";

        });

        });

        const modal=new bootstrap.Modal(
        document.getElementById("modalDesactivar")
        );

        document.querySelectorAll(".btn-desactivar")
        .forEach(btn=>{

        btn.addEventListener("click",()=>{

        const id=btn.dataset.id;

        const nombre=btn.dataset.nombre;

        document.getElementById("nombreUsuario").innerHTML="<strong>"+nombre+"</strong>";

        document.getElementById("formDesactivar").action="/Usuarios/Delete/"+id;

        modal.show();

        });

        });

    </script>

}
