@model MoonBrewCoffee.Web.Models.CurrentUserViewModel

@{
    ViewData["Title"] = "Mi perfil";
    Layout = "_ClienteLayout";
}

<section class="client-page-header">
    <div><span>Tu cuenta</span><h1>Mi perfil</h1><p>Consulta y administra la información asociada a tu cuenta MoonBrew.</p></div>
    <span class="client-page-icon"><i class="bi bi-person"></i></span>
</section>

<section class="client-profile-card">
    <div class="client-profile-summary">
        <span class="client-profile-large-avatar"><i class="bi bi-person"></i></span>
        <div>
            <span>Cliente activo</span>
            <h2>@Model.NombreCompleto</h2>
            <p>@Model.Rol</p>
        </div>
    </div>

    <dl class="client-profile-details">
        <div><dt><i class="bi bi-envelope"></i> Correo electrónico</dt><dd>@(string.IsNullOrWhiteSpace(Model.Correo) ? "No disponible" : Model.Correo)</dd></div>
        <div><dt><i class="bi bi-telephone"></i> Teléfono</dt><dd>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "No disponible" : Model.Telefono)</dd></div>
        <div><dt><i class="bi bi-person-badge"></i> Identificador</dt><dd>@(Model.IdUsuario?.ToString() ?? "Sesión de demostración")</dd></div>
        <div><dt><i class="bi bi-shield-check"></i> Estado</dt><dd><span class="client-profile-status">Activo</span></dd></div>
    </dl>
</section>
