@model IEnumerable<MoonBrewCoffee.Application.DTOs.IngredienteDTO>

@{
    ViewData["Title"] = "Ingredientes";
}

<div class="maintenance-header">

    <div>
        <h1 class="fw-bold mb-1">
            Ingredientes
        </h1>

        <p class="text-muted mb-0">
            Administra los ingredientes de MoonBrew Coffee.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle-fill"></i>
        Nuevo Ingrediente
    </a>

</div>

<div class="card shadow-sm border-0 maintenance-table-panel">

    <div class="card-body">


        <div class="table-responsive">

            <table class="table table-hover align-middle"
                   id="tablaIngredientes">

                <thead>

                    <tr>

                        <th>Nombre</th>

                        <th>Estado</th>

                        <th class="text-center">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <strong>@item.Nombre</strong>

                            </td>

                            <td>

                                @if (item.Activo)
                                {
                                    <span class="badge bg-success">

                                        Activo

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactivo

                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.IdIngrediente"
                                   class="btn btn-info btn-sm me-1">

                                    <i class="bi bi-eye-fill"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.IdIngrediente"
                                   class="btn btn-warning btn-sm me-1">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>

                                <button class="btn btn-danger btn-sm btn-desactivar"
                                        data-id="@item.IdIngrediente"
                                        data-nombre="@item.Nombre">

                                    <i class="bi bi-slash-circle-fill"></i>

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<div class="modal fade"
     id="modalDesactivar"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 rounded-4">

            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title">

                    Desactivar Ingrediente

                </h5>

                <button class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body text-center">

                <i class="bi bi-exclamation-triangle-fill text-danger"
                   style="font-size:65px;">
                </i>

                <h4 class="mt-3">

                    ¿Deseas desactivar este ingrediente?

                </h4>

                <p id="nombreIngrediente"></p>

            </div>

            <div class="modal-footer">

                <button class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <form id="formDesactivar"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button class="btn btn-danger">

                        Sí, Desactivar

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("buscarIngrediente")
        .addEventListener("keyup",function(){

        let filtro=this.value.toLowerCase();

        let filas=document.querySelectorAll("#tablaIngredientes tbody tr");

        filas.forEach(f=>{

        let texto=f.innerText.toLowerCase();

        f.style.display=texto.includes(filtro)?"":"none";

        });

        });

        const modal=new bootstrap.Modal(document.getElementById("modalDesactivar"));

        document.querySelectorAll(".btn-desactivar")
        .forEach(btn=>{

        btn.addEventListener("click",()=>{

        document.getElementById("nombreIngrediente").innerHTML="<strong>"+btn.dataset.nombre+"</strong>";

        document.getElementById("formDesactivar").action="/Ingredientes/Delete/"+btn.dataset.id;

        modal.show();

        });

        });

    </script>

}
