@model MoonBrewCoffee.Application.DTOs.PedidoDTO
@using MoonBrewCoffee.Web.Formatting
@using MoonBrewCoffee.Web.Localization
@using System.Globalization
@inject MoonBrewCoffee.Web.Services.ICurrentUserService CurrentUserService

@{
    var current = CurrentUserService.GetCurrent();
    ViewData["Title"] = $"Pedido #{Model.IdPedido}";
    Layout = current?.EsAdministrador == true || current?.EsEncargado == true ? "_Layout" : "_ClienteLayout";
}

<article class="invoice" data-i18n-title-key="orders.invoice">
    <header class="invoice-header">
        <div class="invoice-brand"><img src="~/Imagenes/moonbrew-mark.png" alt="MoonBrew" /><div><strong>MoonBrew Coffee</strong><span data-i18n-key="orders.invoice">Factura de pedido</span></div></div>
        <div class="invoice-number"><span data-i18n-key="orders.order">Pedido</span><strong>#@Model.IdPedido</strong><small>@Model.FechaPedido.ToString("g", CultureInfo.CurrentCulture)</small></div>
    </header>

    <section class="invoice-information">
        <div><span data-i18n-key="orders.customer">Cliente</span><strong>@Model.ClienteNombre</strong><small>@Model.ClienteCorreo · @Model.ClienteTelefono</small></div>
        <div><span data-i18n-key="orders.manager">Encargado</span><strong>@Model.EncargadoNombre</strong><small data-i18n-key="orders.registrationManager">Responsable del registro</small></div>
        <div><span data-i18n-key="orders.deliveryMethod">Método de entrega</span><strong data-i18n-key="@OrderTranslationKeys.Delivery(Model.TipoEntrega)">@Model.TipoEntrega</strong>@if (Model.DireccionEntrega is null) { <small data-i18n-key="orders.storeRetirement">Retiro en la tienda</small> } else { <small>@Model.DireccionEntrega</small> }</div>
        <div><span data-i18n-key="orders.paymentMethod">Método de pago</span><strong data-i18n-key="@OrderTranslationKeys.Payment(Model.MetodoPago)">@Model.MetodoPago</strong><small data-i18n-key="orders.paymentProcessed">Pago procesado</small></div>
        <div><span data-i18n-key="orders.status">Estado</span><strong class="order-status" style="--status-color:@(Model.EstadoColor ?? "#8b634e")" data-i18n-key="@OrderTranslationKeys.Status(Model.Estado)">@Model.Estado</strong><small data-i18n-key="orders.currentStatus">Estado actual del pedido</small></div>
    </section>

    <section class="order-history-timeline" aria-label="Historial de estados" data-i18n-aria-key="orders.statusHistoryAria">
        <header><span><i class="bi bi-clock-history"></i></span><div><h2 data-i18n-key="orders.trackingTitle">Seguimiento del pedido</h2><p data-i18n-key="orders.trackingCopy">Cada cambio queda registrado automáticamente.</p></div></header>
        @if (Model.HistorialEstados.Count == 0)
        {
            <p class="order-history-empty"><span data-i18n-key="orders.historyUnavailable">Este pedido fue creado antes de habilitar el historial.</span> <span data-i18n-key="orders.currentStatusIs">Su estado actual es</span> <strong data-i18n-key="@OrderTranslationKeys.Status(Model.Estado)">@Model.Estado</strong>.</p>
        }
        else
        {
            <ol>
                @foreach (var change in Model.HistorialEstados)
                {
                    <li style="--history-color:@(change.ColorHex ?? "#8b634e")">
                        <span class="order-history-dot"><i class="bi bi-check2"></i></span>
                        <div><strong data-i18n-key="@OrderTranslationKeys.Status(change.Estado)">@change.Estado</strong><small data-i18n-key="@OrderTranslationKeys.Responsible(change.Responsable)">@change.Responsable</small></div>
                        <time datetime="@change.FechaCambio.ToString("O")">@change.FechaCambio.ToString("g", CultureInfo.CurrentCulture)</time>
                    </li>
                }
            </ol>
        }
    </section>

    <div class="invoice-table-wrap">
        <table class="invoice-table">
            <thead><tr><th data-i18n-key="orders.productOrCombo">Producto o combo</th><th data-i18n-key="orders.price">Precio</th><th data-i18n-key="orders.quantity">Cantidad</th><th data-i18n-key="orders.subtotal">Subtotal</th><th data-i18n-key="orders.tax">Impuesto</th><th data-i18n-key="orders.observations">Observaciones</th></tr></thead>
            <tbody>
                @foreach (var line in Model.Detalles)
                {
                    <tr>
                        <td><span class="invoice-item-type" data-i18n-key="@OrderTranslationKeys.ItemType(line.Tipo)">@line.Tipo</span><strong>@line.Nombre</strong></td>
                        <td>₡@line.PrecioUnitario.ToColones()</td><td>@line.Cantidad</td>
                        <td>₡@line.Subtotal.ToColones()</td><td>₡@line.Impuesto.ToColones()</td>
                        <td>@if (string.IsNullOrWhiteSpace(line.Observaciones)) { <span data-i18n-key="orders.noNotes">Sin observaciones</span> } else { @line.Observaciones }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <footer class="invoice-footer">
        <a asp-action="Index" class="invoice-back"><i class="bi bi-arrow-left"></i> <span data-i18n-key="orders.backToHistory">Volver al historial</span></a>
        <dl>
            <div><dt data-i18n-key="orders.totalWithoutTax">Total sin impuestos</dt><dd>₡@Model.Subtotal.ToColones()</dd></div>
            <div><dt data-i18n-key="orders.tax">Impuesto</dt><dd>₡@Model.Impuesto.ToColones()</dd></div>
            <div><dt data-i18n-key="orders.shipping">Envío</dt><dd>₡@Model.CostoEnvio.ToColones()</dd></div>
            <div class="invoice-grand-total"><dt data-i18n-key="orders.paidTotal">Total pagado</dt><dd>₡@Model.Total.ToColones()</dd></div>
        </dl>
    </footer>
</article>
